GAMEMASTER_STORAGE_DIR=path/to/your/gamemaster/storage/dir
# Remote (HTTP) deployment -- see DEPLOY.md
# MCP_TRANSPORT=stdio            # stdio (default) or http (Streamable HTTP)
# HOST=0.0.0.0
# PORT=8000
# MCP_PATH=/mcp                  # use an unguessable path, e.g. /mcp/<random>, for Claude web/mobile
# MCP_AUTH_TOKEN=                # optional bearer token (Claude Code / API clients)

# Optional: use Postgres (e.g. Supabase) instead of local JSON files when set
DATABASE_URL=
